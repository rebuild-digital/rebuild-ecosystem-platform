# Notion (directory data source)
NOTION_TOKEN=
NOTION_BUILDERS_DB_ID=

# Bunny CDN / Storage (platform logos, plan §2.3a). BUNNY_STORAGE_KEY is the
# storage zone's password; BUNNY_CDN_URL its pull zone, e.g.
# https://rebuild-media.b-cdn.net; BUNNY_STORAGE_HOST the zone's region
# endpoint (default storage.bunnycdn.com).
BUNNY_CDN_URL=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_HOST=

# Analytics (Pirsch)
PIRSCH_CODE=

# MailerLite
MAILERLITE_API_KEY=

# Bunny Edge Script (form submission backend)
API_URL=

# Postgres (Risved injects this in staging/production). Locally: your own
# Postgres, e.g. postgres://localhost:5432/rebuild. Leave empty to run
# without a database (migrations are skipped).
DATABASE_URL=
# "true" imports the Notion directory into Postgres at boot (plan §2.3).
# Locally, use `npm run db:import-notion` instead.
NOTION_IMPORT=
# "postgres" serves the directory from Postgres (plan §2.4); anything else
# keeps Notion. Falls back to Notion if Postgres fails or is empty.
DIRECTORY_SOURCE=

# Nightly encrypted database backups (plan §7.11, ADR 0007). A PRIVATE Bunny
# zone with no pull zone; never the logo zone above. BACKUP_AGE_RECIPIENT is
# the public key from `npm run backup:keygen`; the private key stays offline.
# BACKUP_ON_BOOT=true runs one backup right after startup.
BACKUP_STORAGE_ZONE=
BACKUP_STORAGE_KEY=
BACKUP_STORAGE_HOST=
BACKUP_AGE_RECIPIENT=
BACKUP_ON_BOOT=

# Site
VITE_SITE_URL=http://localhost:3000
# "true" only in production (Phase 4 cutover); anything else serves noindex
VITE_SITE_INDEXABLE=
